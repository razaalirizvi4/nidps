# Copy this file to .env and fill in real values for your machine. common/env.py::load_env()
# loads .env automatically at the start of every service's main() -- nothing needs to be
# exported in your shell. A value already exported in your shell (or set some other way, e.g. a
# systemd unit's Environment=) always wins over .env; .env only fills in what's unset.
#
# .env itself is gitignored (see .gitignore) -- it's local machine config, not shared.

# --- Shared by every service ---
NIDPS_DB_PATH=./nidps.sqlite3
NIDPS_REDIS_URL=redis://localhost:6379/0

# --- services.flowextract / services.arpmon (packet capture; need root or CAP_NET_RAW) ---
# Run `ip link` (Linux) or `ifconfig`/`networksetup -listallhardwareports` (macOS) to find yours --
# the default below is almost never correct.
NIDPS_CAPTURE_INTERFACE=eth0

# --- services.arpmon only (required -- it will crash without these) ---
# NIDPS_GATEWAY_IP=192.168.1.1
# NIDPS_AP_MAC=aa:bb:cc:dd:ee:ff
# NIDPS_DHCP_LEASE_PATH=/var/lib/misc/dnsmasq.leases

# --- services.sigbridge (Suricata bridge) ---
# NIDPS_EVE_JSON_PATH=/tmp/eve.json

# --- services.dashboard ---
NIDPS_DASHBOARD_HOST=0.0.0.0
NIDPS_DASHBOARD_PORT=8443
# Required only if the frontend (frontend/, served separately, e.g. on :5173) runs on a different
# origin than this API -- comma-separated list of allowed frontend origins.
NIDPS_DASHBOARD_CORS_ORIGINS=http://localhost:5173
